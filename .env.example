# API key de Google Gemini para la sección /ask (chat interactivo).
# Consíguela gratis en https://aistudio.google.com/apikey
# Nunca hardcodear la key en el código ni exponerla al cliente — este proyecto
# la usa solo desde el route handler del servidor (src/app/api/chat/route.ts).
GEMINI_API_KEY=

# Opcional: sobrescribe el modelo usado por el chat (por defecto gemini-3.6-flash)
GEMINI_MODEL=

# --- Panel de admin (/keystatic), gestionado con Keystatic ---
# Requiere una GitHub App (ver src/../keystatic.config.ts y docs de Keystatic
# "GitHub mode"). Estas 4 variables se generan al crear la App.

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- SEO (sitemap, robots.txt, canonical/hreflang tags) ---
# Dominio público del sitio, sin barra final. Actualízalo en cuanto
# tengas un dominio propio — todo lo demás (sitemap, robots, canonical)
# lo lee de aquí automáticamente (ver src/lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://cv-one-tau.vercel.app
