# API key de Anthropic para la sección /ask (chat interactivo).
# Nunca hardcodear la key en el código ni exponerla al cliente — este proyecto
# la usa solo desde el route handler del servidor (src/app/api/chat/route.ts).
ANTHROPIC_API_KEY=

# Opcional: sobrescribe el modelo usado por el chat (por defecto claude-sonnet-4-6)
ANTHROPIC_MODEL=
