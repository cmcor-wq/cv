# API key de Google Gemini para la sección /ask (chat interactivo).
# Consíguela gratis en https://aistudio.google.com/apikey
# Nunca hardcodear la key en el código ni exponerla al cliente — este proyecto
# la usa solo desde el route handler del servidor (src/app/api/chat/route.ts).
GEMINI_API_KEY=

# Opcional: sobrescribe el modelo usado por el chat (por defecto gemini-3.6-flash)
GEMINI_MODEL=

# --- Panel de admin (/admin) para editar los textos del sitio sin pasar por la IA ---

# Hash de la contraseña de acceso. Generarlo una vez con:
#   node scripts/hash-admin-password.mjs "tu contraseña"
# y pegar aquí el resultado. La contraseña en claro no se guarda en ningún sitio.
ADMIN_PASSWORD_HASH=

# Cadena aleatoria para firmar la cookie de sesión del admin (ej: openssl rand -hex 32).
ADMIN_SESSION_SECRET=

# Fine-grained personal access token de GitHub con permiso Contents: Read & Write
# limitado a este repo. El admin lo usa para comitear los cambios de texto.
GITHUB_ADMIN_TOKEN=

# Repo y rama donde el admin comitea los cambios (esa rama debe ser la que Vercel
# despliega a producción).
GITHUB_ADMIN_REPO=cmcor-wq/cv
GITHUB_ADMIN_BRANCH=main
